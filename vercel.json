{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/v2/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, must-revalidate" }
      ]
    }
  ],
  "functions": {
    "api/archive-detail.js": {
      "maxDuration": 60
    },
    "api/archive-generate.js": {
      "maxDuration": 120
    }
  },
  "crons": [
    {
      "path": "/api/refresh-news",
      "schedule": "*/30 6-22 * * *"
    },
    {
      "path": "/api/refresh-news",
      "schedule": "0 23,0,1,2,3,4,5 * * *"
    }
  ]
}